# Supabase — server-side only.
#
# The secret key bypasses row level security. It must never be prefixed
# NEXT_PUBLIC_, which would ship it to every visitor's browser. Set it in
# Vercel's environment variables, not in a committed file.
#
# Get it from Settings > API Keys > "Publishable and secret API keys":
# https://supabase.com/dashboard/project/nfpzpnbshhhdxhbaywdg/settings/api-keys
SUPABASE_URL=https://nfpzpnbshhhdxhbaywdg.supabase.co
SUPABASE_SECRET_KEY=

# Legacy alternative, still accepted if that is the key you have.
# SUPABASE_SERVICE_ROLE_KEY=

# The canonical origin, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://mesub.io
